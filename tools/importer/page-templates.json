{
  "templates": [
    {
      "name": "about-us",
      "urls": [
        "https://wknd.site/us/en/about-us.html",
        "https://wknd.site/us/en/magazine.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/about-us.html",
      "description": "About Us and Magazine listing: H1 title with underlined H2 groups; about-us has contributor/guide profile cards, magazine has featured article, All Articles cards and members-only teasers (all blocks optional per page)",
      "blocks": [
        {
          "name": "columns-featured",
          "instances": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .teaser.cmp-teaser--featured"
          ]
        },
        {
          "name": "cards-contributor",
          "instances": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > :not(section.cmp-experience-fragment--contributor) + section.cmp-experience-fragment--contributor"
          ]
        },
        {
          "name": "cards-listing",
          "instances": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .image-list.list"
          ]
        },
        {
          "name": "cards-members",
          "instances": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > :not(.cmp-teaser--secure) + .teaser.cmp-teaser--secure"
          ]
        }
      ],
      "urlPattern": "/us/en/*",
      "sections": [
        {
          "id": "1",
          "name": "Page title (+ featured article on magazine)",
          "selector": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .title:not(.cmp-title--underline)"
          ],
          "style": null,
          "blocks": [
            "columns-featured"
          ],
          "defaultContent": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .title:not(.cmp-title--underline) h1"
          ]
        },
        {
          "id": "2",
          "name": "Our Contributors",
          "selector": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .title:not(.cmp-title--underline) + .title.cmp-title--underline"
          ],
          "style": "small-text",
          "blocks": [
            "cards-contributor"
          ],
          "defaultContent": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .title:not(.cmp-title--underline) + .title.cmp-title--underline h2",
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .title.cmp-title--underline + .text"
          ]
        },
        {
          "id": "3",
          "name": "WKND Guides",
          "selector": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > section.cmp-experience-fragment--contributor + .title.cmp-title--underline"
          ],
          "style": "small-text",
          "blocks": [
            "cards-contributor"
          ],
          "defaultContent": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > section.cmp-experience-fragment--contributor + .title.cmp-title--underline h2",
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > section.cmp-experience-fragment--contributor + .title.cmp-title--underline + .text"
          ]
        },
        {
          "id": "4",
          "name": "All Articles",
          "selector": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .teaser.cmp-teaser--featured + .title.cmp-title--underline"
          ],
          "style": null,
          "blocks": [
            "cards-listing"
          ],
          "defaultContent": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .teaser.cmp-teaser--featured + .title.cmp-title--underline h2"
          ]
        },
        {
          "id": "5",
          "name": "Members Only intro",
          "selector": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .image-list.list + .title.cmp-title--underline"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .image-list.list + .title.cmp-title--underline h2",
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .image-list.list + .title.cmp-title--underline + .text"
          ]
        },
        {
          "id": "6",
          "name": "Members-only teasers",
          "selector": [
            "main.cmp-layout-container--fixed > .cmp-container > .aem-Grid > .separator + .teaser.cmp-teaser--secure"
          ],
          "style": "divider-medium",
          "blocks": [
            "cards-members"
          ],
          "defaultContent": []
        }
      ]
